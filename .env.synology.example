# Copy this file to .env on the Synology NAS. Never commit .env.
NEXT_PUBLIC_SITE_URL=https://literature.lhsstart.synology.me
NEXT_PUBLIC_PORTAL_URL=https://lhsstart.synology.me
NEXT_PUBLIC_SUPABASE_URL=https://supabase.lhsstart.synology.me
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Optional: only needed if your Supabase configuration uses server-role actions.
SUPABASE_SERVICE_ROLE_KEY=
# Optional: only needed for the teacher-only AI source loader.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
TEACHER_EMAILS=
STUDENT_EMAILS=
TEACHER_INVITE_CODE=
# Q&A reply notifications. You can reuse the SMTP account configured for
# Supabase Auth, but these values must also exist in literature-app/.env.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=수빙니기는 문학시간
